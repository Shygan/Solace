  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2da583148f3e01848b43ab66d164ffa4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  textComponent: {fileID: 1156867762}
  lines:
  - Something doesn't feel right...everything feels distant and distorted.
  - When anxiety overwhelms you, it helps to ground yourself in the present moment.
  - This coping technique is called the grounding technique. Focus on your senses.
    One at a time.
  - 'Start with sight: Find 5 blue boxes you can see.'
  - Let each discovery bring you back to reality!
  textSpeed: 0.05
  playerMovement: {fileID: 0}
  platformToReveal: {fileID: 0}
  autoStart: 1
  nextDialogue: {fileID: 0}
  levelToReturnTo: 
  levelsParent: {fileID: 0}
  player: {fileID: 0}
  fogEventManager: {fileID: 0}
  groundingController: {fileID: 0}
  useAIThoughtExplanation: 0
